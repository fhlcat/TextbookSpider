<Window x:Class="TextbookSpiderWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="教材下载助手" Height="790" Width="1160" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="#F3F5F9" FontFamily="Microsoft YaHei UI"
        Foreground="#17243B" DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Background" Value="#E8EDF5"/>
            <Setter Property="Foreground" Value="#243650"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="#D5DDE8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E2E7F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="教材下载助手" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="选择教材分类，设置保存位置，批量下载 PDF 教材。" Foreground="#66758B" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="刷新" Padding="12,6" Command="{Binding MainViewmodel.StartFetchingFoldersCommand}"/>
                        <TextBlock Text="教材目录" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="选择分类将下载其下所有教材" Foreground="#66758B" Margin="0,0,0,12"/>
                    <TreeView Grid.Row="2" BorderThickness="0" Background="Transparent"
                              ItemsSource="{Binding MainViewmodel.Folders}" SelectedItemChanged="FolderSelected" IsEnabled="{Binding MainViewmodel.IsIdle}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem"><Setter Property="Padding" Value="3,5"/></Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Subfolders}">
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="160"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="下载设置" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                        <Grid IsEnabled="{Binding MainViewmodel.IsIdle}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="保存位置" Margin="0,0,0,6"/>
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MainViewmodel.SavePath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseFolder"/>
                                <Button Grid.Column="2" Content="打开目录" Margin="8,0,0,0" Click="OpenFolder"/>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="Auth 令牌" Margin="0,0,0,6"/>
                            <PasswordBox Grid.Row="3" x:Name="AuthBox" PasswordChanged="AuthChanged" Padding="10,9" BorderBrush="#D5DDE8"
                                         ToolTip="填写你自己的 x-nd-auth 令牌；仅用于当前会话，不保存到磁盘。"/>
                        </Grid>
                        <TextBlock Text="下载前请填写有效的 x-nd-auth 令牌，仅用于当前会话。" Foreground="#66758B" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding MainViewmodel.SelectionText}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>
                        <ListView Grid.Row="1" ItemsSource="{Binding MainViewmodel.SelectedBooks}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="清空" Click="ClearLogs" Padding="10,3"/>
                            <TextBlock Text="运行日志" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LogsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0" FontSize="12" Foreground="#66758B"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MainViewmodel.Status}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Minimum="0" Maximum="{Binding MainViewmodel.TotalBooks}" Value="{Binding MainViewmodel.CompletedBooks}"
                                 IsIndeterminate="{Binding MainViewmodel.IsLoading}" Height="5" Margin="0,8,0,5"/>
                    <TextBlock Text="{Binding MainViewmodel.ProgressText}" Foreground="#66758B" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1" Content="取消" Command="{Binding MainViewmodel.CancelCommand}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="开始下载" Command="{Binding MainViewmodel.StartWorkingCommand}" Background="#3265D9" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
