<Window x:Class="TextbookSpiderWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="400"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0">folder</TextBlock>
        <TreeView Name="FoldersTreeView" Grid.Row="1" Padding="4"
                  ItemsSource="{Binding FoldersViewmodel.Folders, Mode=OneWay}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Subfolders}">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <TextBlock Grid.Row="2" Margin="0 8 0 0">auth</TextBlock>
        <TextBox Grid.Row="3" Padding="4"
                 Text="{Binding MainViewmodel.Auth, Mode=OneWayToSource}"
                 TextWrapping="Wrap" />
        <TextBlock Grid.Row="4" Margin="0 8 0 0">log</TextBlock>
        <ScrollViewer Grid.Row="5" Padding="4">
            <TextBlock Text="{Binding LogsText, Mode=OneWay}" TextWrapping="Wrap"/>
        </ScrollViewer>
        <Button Grid.Row="6" Padding="8" Margin="0 16 0 0"
                Command="{Binding MainViewmodel.StartWorkingCommand}"
                CommandParameter="{Binding SelectedValue, ElementName=FoldersTreeView, Mode=OneWay}">
            Start
        </Button>
    </Grid>
</Window>